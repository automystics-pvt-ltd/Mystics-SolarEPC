# ─────────────────────────────────────────────────────────────────────────────
# Mystics ERP — Production Environment Variables
# Copy to /opt/mystics/.env.production and fill in every value before deploying.
# Never commit the actual .env.production file to source control.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── API Server ────────────────────────────────────────────────────────────────
PORT=8080

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL=postgresql://mystics_user:CHANGE_ME@127.0.0.1:5432/mystics_erp

# JWT signing secret — generate with: openssl rand -base64 64
SESSION_SECRET=CHANGE_ME_use_openssl_rand_base64_64

# ── Frontend Build ────────────────────────────────────────────────────────────
# Set BASE_PATH to '/' when served from the domain root.
# Set to '/app' if the ERP is served under a sub-path (e.g. https://yourdomain.com/app).
BASE_PATH=/

# ── File / Object Storage ─────────────────────────────────────────────────────
# Use 'local' for VPS disk storage (no cloud setup required).
# Use 'replit' only when running inside the Replit workspace.
STORAGE_BACKEND=local

# Absolute path to the directory where uploaded files are stored.
# Make sure the directory exists and is writable by the process user.
LOCAL_UPLOAD_DIR=/opt/mystics/data/uploads

# The public-facing API base URL (used to build local upload URLs for clients).
# Must be reachable from the browser — include protocol, no trailing slash.
PUBLIC_API_URL=https://api.yourdomain.com

# ── Replit Object Storage (leave blank for VPS / local storage) ───────────────
# Only needed when STORAGE_BACKEND=replit
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
